{
  "version": 2,
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/admin(.*)", "dest": "/admin$1" },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "outputDirectory": "public"
}
